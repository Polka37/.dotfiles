## Variables

# Logo key. Use Mod1 for Alt.
set $mod Mod4

# Home row direction keys, like vim
set $left h
set $down j
set $up k
set $right l

# Preferences
set $term kitty
set $browser firefox
set $launcher wofi -I --show drun
set $screeshot flameshot gui
set $files nemo
set $music kitty ~/Documents/Appimage/rmpc
set $editor kitty nvim
set $image_editor /usr/bin/flatpak run --branch=stable --arch=x86_64 --command=krita --file-forwarding org.kde.krita 
set $chat /usr/bin/flatpak run --branch=stable --arch=x86_64 --command=startvesktop --file-forwarding dev.vencord.Vesktop @@u %U @@
# Key bindings
include ~/.config/sway/keybinds

include /etc/sway/config-vars.d/*

## Theme

# Default wallpaper
# output * bg ~/.config/sway/wallpaper/renmari.jpg fill
# output * bg ~/.config/sway/wallpaper/yuyou.jpg fill
 output * bg ~/.config/sway/wallpaper/yukayu.jpg fill
#output * bg ~/.config/sway/wallpaper/yukareimu.png fill
# output * bg ~/.config/sway/wallpaper/Reimari.jpeg fill
# output * bg ~/.config/sway/wallpaper/yuyu.jpg fill
# output * bg ~/.config/sway/wallpaper/rin.jpg fill

# Colors
# class                 border  backgr. text    indicator child_border
client.focused          #ac82e9 #181825 #d8cab8 #ac82e9 #ac82e9
client.focused_inactive #27232b #181825 #d8cab8 #27232b #27232b
client.unfocused        #27232b #181825 #888888 #27232b #27232b
client.urgent           #fcb167 #141216 #fcb167 #fcb167 #fcb167
client.placeholder      #27232b #181825 #d8cab8 #27232b #27232b

# Status Bar:
bar {
  swaybar_command waybar 
}

# Font
font pango:Maple Mono 10

# Gaps
gaps inner 6px
gaps outer 4px

# Border
default_border pixel 3px
default_floating_border pixel 3px

## Device settings
input "type:touchpad" {
    dwt disabled
    dwtp disabled
    tap enabled
    click_method button_areas
    middle_emulation disabled
    natural_scroll enabled
    scroll_factor 1
    pointer_accel 1.0
    accel_profile flat 
}
input "type:pointer" {
    natural_scroll enabled
    scroll_factor 1.2
}
input "type:keyboard" {
    xkb_layout pl,us
}

# Startup
exec swaync
exec mpris-proxy
exec /usr/libexec/polkit-mate-authentication-agent-1
exec bash -c "input-remapper-control --command stop-all && input-remapper-control --command autoload"

# Autostart
exec $browser
exec steam -silent
exec blueman-applet
exec $chat
for_window [class="discord"] move to workspace 3
for_window [app_id="vesktop"] move to workspace 3
for_window [class="krita"] move to workspace 2

include /etc/sway/config.d/*

